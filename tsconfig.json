{
  // One TypeScript config for the whole repo: Lambda code (backend/),
  // the React app (web/), shared types (shared/) and scripts (scripts/).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["backend", "web/src", "shared", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
