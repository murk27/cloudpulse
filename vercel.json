{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/check", "schedule": "0 6 * * *" }]
}
