# Every environment variable CloudPulse uses. On Vercel, set them in
# Project -> Settings -> Environment Variables. Locally, `npx vercel env pull .env.local`
# downloads them into .env.local (which git ignores). `npm run dev` needs none of them.

# Upstash Redis REST credentials. The Vercel Marketplace integration adds these automatically
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN instead; CloudPulse accepts both).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the admin dashboard.
ADMIN_PASSWORD=

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: Discord channel webhook URL for DOWN / RECOVERED alerts.
DISCORD_WEBHOOK_URL=

# Not used by the app itself: add it as a GitHub repository secret for .github/workflows/check.yml.
APP_URL=
